{
  "name": "sopho-pi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "个人助手：事项账本 + Web UI，pi 作为 agent 引擎",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "a": "node bin/ledger.mjs",
    "retro": "node bin/retro.mjs",
