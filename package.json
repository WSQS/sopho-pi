{
  "name": "sopho-pi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "个人助手：事项账本 + Web UI，pi 作为 agent 引擎",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "serve": "bash bin/serve.sh",
    "stop": "bash bin/stop.sh",
    "reload": "bash bin/reload-base.sh",
    "restart": "bash bin/restart-base.sh",
    "serve:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/dev-serve.ps1",
    "stop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/dev-serve.ps1 -Stop",
    "serve:win": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/serve-win.ps1",
    "stop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/stop-win.ps1",
    "test:scroll": "node web/test-scroll.mjs",
    "test:proxy": "node test/proxy-abort.mjs",
    "test:delivery": "node test/race-message.mjs",
    "test:compact-window": "node test/compact-window.mjs",
    "test:header": "node test/header-of.mjs",
    "test:page": "node test/reading-page.mjs",
    "test:extract": "node test/epub-extract.mjs",
    "test:api": "node test/page-api.mjs",
    "test:tools": "node test/tools-loop.mjs",
    "test:toolstate": "node test/tool-state.mjs",
    "test:livededup": "node web/test-live-dedup.mjs",
    "test:cwd": "node test/cwd.mjs",
    "test:page-demo": "node test/reading-page-demo.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1"
  }
}
